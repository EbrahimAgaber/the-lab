{
  "name": "the-lab",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "apps/desktop"
  ],
  "scripts": {
    "test": "npm run lint && npm run check:rtl && npm run typecheck && npm run test:core && npm run test:ui",
    "test:core": "npm run test --workspace=@the-lab/core",
    "test:ui": "npm run test --workspace=@the-lab/ui",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/ui --noEmit",
    "lint": "eslint .",
    "check:rtl": "node scripts/check-rtl.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace=@the-lab/ui",
    "dev:desktop": "npm run dev --workspace=@the-lab/desktop",
    "build": "npm run build --workspace=@the-lab/ui"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1"
  },
  "engines": {
    "node": ">=22"
  }
}
